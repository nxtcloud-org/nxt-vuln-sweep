# _core/sweep init <고객> 이 $SWEEP_RUNS/<고객>/config.env 로 복사한다 (리포 밖). 리포 안에 두지 않는다.
# _core/*.sh 가 RUN_DIR/../config.env 를 읽는다.

# AWS CLI 프로파일 (SSO면 사용자가 먼저 aws sso login --profile <이름> 실행)
AWS_PROFILE=customer-sso
# 기본 리전 (자산 조회는 활성 리전 전체를 돈다. REGIONS 로 좁힐 수 있음)
AWS_REGION=ap-northeast-2
# REGIONS="ap-northeast-2 us-east-1"

# SSM 에이전트가 없는 서버를 bastion 경유로 점검할 때만 필요
# ~/.ssh/config 의 bastion Host 별칭 (HostName, User, IdentityFile 이 거기 정의되어 있어야 함)
BASTION=customer-bastion
# 대상 서버 접속 키 (키 인증만 사용)
BASTION_KEY=~/keys/customer/prd_ec2_key.pem
